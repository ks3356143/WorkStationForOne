{
  "name": "workstation-for-one",
  "version": "0.9.0",
  "private": true,
  "description": "WorkStationForOne — 个人 AI 工作站",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "start": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify": "npm run build && node scripts/runtime-verify.mjs",
    "capture": "npm run build && node scripts/capture.mjs",
    "package": "node scripts/package.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
